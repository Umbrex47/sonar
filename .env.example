# ==============================================================================
# RADAR 30X - VARIABLES DE ENTORNO Y CONFIGURACIÓN
# ==============================================================================
# Copia este archivo a `.env` y completa tus credenciales según las fuentes que desees activar.
# El sistema cuenta con mecanismos de fallback y mock determinista para pruebas offline.

# ------------------------------------------------------------------------------
# 1. Jev / TypeSafe AI (Motor de Decisiones Type-Safe)
# ------------------------------------------------------------------------------
# Obtén tu clave en https://console.typesafe.ai
# Permite clasificar fase, gancho, formato, novedad y encaje de audiencia con probabilidades calibradas.
TYPESAFE_API_KEY=tu_typesafe_api_key_aqui

# ------------------------------------------------------------------------------
# 2. YouTube Data API v3
# ------------------------------------------------------------------------------
# Obtén tu clave en Google Cloud Console habilitando YouTube Data API v3.
# Se utiliza para medir métricas reales de formato y ratio vistas/hora.
YOUTUBE_API_KEY=tu_youtube_api_key_aqui

# ------------------------------------------------------------------------------
# 3. LLM de Redacción / Narrativa (Económico / Abierto)
# ------------------------------------------------------------------------------
# Jev toma las decisiones estructuradas. El LLM redacta la explicación "por qué" y "adaptación 30X".
# Soporta OpenAI, Anthropic, Gemini o DeepSeek.
LLM_PROVIDER=openai  # Opciones: openai | anthropic | gemini | deepseek | mock
LLM_API_KEY=tu_llm_api_key_aqui
LLM_MODEL=gpt-4o-mini # O claude-3-haiku-20240307, deepseek-chat, gemini-1.5-flash

# ------------------------------------------------------------------------------
# 4. Reddit Data API (Opcional - Tier Gratuito No-Comercial)
# ------------------------------------------------------------------------------
# Crear app en https://www.reddit.com/prefs/apps (tipo script o web)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=radar30x:v0.1.0 (by /u/30x_dev)

# ------------------------------------------------------------------------------
# 5. Parámetros de Operación
# ------------------------------------------------------------------------------
# Rutas locales
RADAR_DB_PATH=data/radar.db
MANUAL_CSV_PATH=data/manual.csv
OUTPUT_DIR=out

# Umbral de similitud difusa para agrupamiento (rapidfuzz token_set_ratio)
CLUSTER_SIMILARITY_THRESHOLD=0.75
